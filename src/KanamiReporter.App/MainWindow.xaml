<Window
    x:Class="KanamiReporter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:KanamiReporter.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="香奈美x黑潮爆破">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏：背景保持透明并继承窗口材质，文字使用主题 token -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,176,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Width="20" Height="20" Source="ms-appx:///Assets/AppIcon.png" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextPrimaryBrush}"
                    Text="香奈美x黑潮爆破" />
                <Border Style="{StaticResource StatusPill}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse
                            x:Name="TitleStatusDotIdle"
                            Width="6"
                            Height="6"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource TextMutedBrush}" />
                        <Ellipse
                            x:Name="TitleStatusDotRunning"
                            Width="6"
                            Height="6"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource TextSuccessBrush}"
                            Visibility="Collapsed" />
                        <TextBlock x:Name="TitleStatusText" Style="{StaticResource PillText}" Text="待机" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock
                x:Name="TitleSourceText"
                Grid.Column="1"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionText}"
                Text="未选择捕获源"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <NavigationView
            x:Name="MainNav"
            Grid.Row="1"
            Background="Transparent"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            OpenPaneLength="180"
            PaneDisplayMode="LeftCompact">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="RunNavItem" Content="运行" Tag="run">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNavItem" Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AboutNavItem" Content="关于与日志" Tag="about">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Margin="20,16,20,20">
                <!-- ================= 运行 ================= -->
                <Grid x:Name="RunView" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="8">
                        <InfoBar
                            x:Name="WelcomeBar"
                            IsClosable="True"
                            IsOpen="False"
                            Message="模板与语音已随程序内置，首次启动会自动准备，无需再导入资源包。"
                            Severity="Informational"
                            Title="内置资源包已就绪" />

                        <!-- 控制条 -->
                        <Border Padding="16,12" Style="{StaticResource Card}">
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionText}"
                                        Text="捕获源" />
                                    <ComboBox
                                        x:Name="CaptureTargets"
                                        Grid.Column="1"
                                        MaxWidth="520"
                                        HorizontalAlignment="Left"
                                        DisplayMemberPath="DisplayName"
                                        PlaceholderText="选择游戏窗口或显示器"
                                        ToolTipService.ToolTip="列表每 2 秒自动刷新；识别进行中会暂停刷新。" />
                                    <Button
                                        x:Name="RefreshTargetsButton"
                                        Grid.Column="2"
                                        Content="立即刷新"
                                        Click="RefreshTargets_Click" />
                                    <Button
                                        x:Name="StartRecognitionButton"
                                        Grid.Column="3"
                                        Content="开始识别"
                                        Click="StartRecognition_Click"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        x:Name="StopRecognitionButton"
                                        Grid.Column="4"
                                        Content="停止"
                                        Click="StopRecognition_Click" />
                                </Grid>

                                <TextBlock
                                    x:Name="CaptureHintText"
                                    Style="{StaticResource CaptionText}"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 主体：预览 + 右栏 -->
                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="400" />
                        </Grid.ColumnDefinitions>

                        <!-- 预览舞台 -->
                        <Border Grid.Column="0" Style="{StaticResource CardTight}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <!-- 空闲底色跟随主题，避免未识别时出现大片黑洞 -->
                                    <Border
                                        x:Name="StageIdleSurface"
                                        Background="{ThemeResource SurfaceIdleBrush}"
                                        CornerRadius="{StaticResource RadiusStageTop}" />
                                    <!-- 视频舞台始终保持深色 -->
                                    <Border
                                        x:Name="StageRunningSurface"
                                        Background="{StaticResource StageSurfaceBrush}"
                                        CornerRadius="{StaticResource RadiusStageTop}"
                                        Visibility="Collapsed" />

                                    <Image x:Name="RunPreviewImage" Stretch="Uniform" />

                                    <Border
                                        x:Name="FpsBadge"
                                        Margin="14"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource OverlayBadge}"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            x:Name="FpsText"
                                            FontFamily="{StaticResource MonoFontFamily}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextOnVideoBrush}"
                                            Text="0.0 帧/秒" />
                                    </Border>

                                    <Border
                                        x:Name="PreviewStatusBadge"
                                        Margin="14"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource OverlayBadge}"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            x:Name="PreviewStatusText"
                                            Foreground="{ThemeResource TextOnVideoBrush}"
                                            Text="等待采集" />
                                    </Border>

                                    <StackPanel
                                        x:Name="PreviewEmptyState"
                                        MaxWidth="360"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                        <Image
                                            Width="56"
                                            Height="56"
                                            HorizontalAlignment="Center"
                                            Source="ms-appx:///Assets/AppIcon.png" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource MetricValue}"
                                            Text="还没有开始识别" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextSecondaryBrush}"
                                            Text="选择上面的捕获源，然后点击开始识别。识别过程中这里会实时显示游戏画面。"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                        <Button
                                            x:Name="EmptyStateStartButton"
                                            HorizontalAlignment="Center"
                                            Click="StartRecognition_Click"
                                            Content="开始识别"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>
                                </Grid>

                                <!-- 预览页脚 -->
                                <Grid
                                    Grid.Row="1"
                                    Padding="16,10"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            x:Name="LastAnnouncementText"
                                            Style="{StaticResource BodyText}"
                                            Text="最近播报：—"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            x:Name="VoicePlaybackText"
                                            Style="{StaticResource CaptionText}"
                                            Text="语音：空闲" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="PreviewFooterMetaText"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionText}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 右栏 -->
                        <Grid Grid.Column="1" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 对局观测 -->
                            <Border Padding="16,14" Style="{StaticResource Card}">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SectionHeader}" Text="对局观测" />
                                        <Border Grid.Column="1" Style="{StaticResource StatusPill}">
                                            <TextBlock x:Name="GamePhaseText" Style="{StaticResource PillText}" Text="等待识别" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse
                                            x:Name="StateActiveDot"
                                            Width="9"
                                            Height="9"
                                            VerticalAlignment="Center"
                                            Fill="{ThemeResource TextBrandBrush}"
                                            Visibility="Collapsed" />
                                        <TextBlock
                                            x:Name="CurrentStateText"
                                            FontSize="26"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextPrimaryBrush}"
                                            Text="未知" />
                                    </StackPanel>

                                    <Grid ColumnSpacing="10" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border Style="{StaticResource Tile}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource MetricLabel}" Text="估算倒计时" />
                                                <TextBlock
                                                    x:Name="GameCountdownText"
                                                    Style="{StaticResource MonoMetricValue}"
                                                    FontSize="24"
                                                    Foreground="{ThemeResource TextBrandBrush}"
                                                    Text="--:--" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Style="{StaticResource Tile}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource MetricLabel}" Text="回合 / 阵营" />
                                                <TextBlock
                                                    x:Name="GameRoundText"
                                                    Style="{StaticResource MetricValue}"
                                                    FontSize="17"
                                                    Text="回合 --" />
                                                <TextBlock x:Name="GameSideText" Style="{StaticResource CaptionText}" Text="阵营：未知" />
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Style="{StaticResource Tile}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource MetricLabel}" Text="阶段计时 / 下一判定" />
                                                <TextBlock x:Name="DebugStateDurationText" Style="{StaticResource BodyText}" Text="阶段计时：0 秒" />
                                                <TextBlock
                                                    x:Name="GameEventText"
                                                    Foreground="{ThemeResource TextTimerBrush}"
                                                    Text="等待识别数据"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 模板匹配 -->
                            <Border
                                Grid.Row="1"
                                Padding="16,14"
                                Style="{StaticResource Card}">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SectionHeader}" Text="模板匹配" />
                                        <TextBlock
                                            x:Name="MatchSummaryText"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CaptionText}"
                                            Text="当前 —" />
                                    </Grid>

                                    <ScrollViewer
                                        x:Name="TemplateScoreScroll"
                                        Grid.Row="1"
                                        VerticalScrollBarVisibility="Auto"
                                        VerticalScrollMode="Auto">
                                        <ItemsRepeater x:Name="TemplateScoreRepeater">
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="local:TemplateScoreItem">
                                                    <Grid Margin="0,0,0,2">
                                                        <Border
                                                            Background="{ThemeResource BrandSoftBrush}"
                                                            CornerRadius="{StaticResource RadiusTile}"
                                                            Visibility="{x:Bind IsHit, Mode=OneWay}" />
                                                        <Grid Padding="8,6" ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="24" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="56" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                FontFamily="{StaticResource MonoFontFamily}"
                                                                FontSize="12"
                                                                Foreground="{ThemeResource TextTertiaryBrush}"
                                                                Text="{x:Bind RankText, Mode=OneWay}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Foreground="{ThemeResource TextPrimaryBrush}"
                                                                Text="{x:Bind StateName}"
                                                                TextTrimming="CharacterEllipsis"
                                                                ToolTipService.ToolTip="{x:Bind Description}" />
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                FontFamily="{StaticResource MonoFontFamily}"
                                                                FontSize="12"
                                                                Foreground="{ThemeResource TextSecondaryBrush}"
                                                                Text="{x:Bind ScoreText, Mode=OneWay}"
                                                                TextAlignment="Right"
                                                                ToolTipService.ToolTip="与模板画面的相似度；– 表示该状态没有模板，或这一帧画面缺少可比对的内容。" />

                                                            <StackPanel
                                                                Grid.Column="3"
                                                                HorizontalAlignment="Right"
                                                                Orientation="Horizontal"
                                                                Spacing="6">
                                                                <Border
                                                                    Background="{ThemeResource SuccessSoftBrush}"
                                                                    Style="{StaticResource StatusPill}"
                                                                    Visibility="{x:Bind IsHit, Mode=OneWay}">
                                                                    <TextBlock
                                                                        Foreground="{ThemeResource TextSuccessBrush}"
                                                                        Style="{StaticResource PillText}"
                                                                        Text="命中" />
                                                                </Border>
                                                                <Border
                                                                    Background="{ThemeResource MutedSoftBrush}"
                                                                    Style="{StaticResource StatusPill}"
                                                                    ToolTipService.ToolTip="该状态没有对应的模板文件，因此不会参与识别。模板存放在数据目录的 templates 文件夹。"
                                                                    Visibility="{x:Bind IsNoTemplate, Mode=OneWay}">
                                                                    <TextBlock
                                                                        Foreground="{ThemeResource TextMutedBrush}"
                                                                        Style="{StaticResource PillText}"
                                                                        Text="无模板" />
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </ScrollViewer>

                                    <TextBlock
                                        Grid.Row="2"
                                        Style="{StaticResource CaptionText}"
                                        Text="分数 = 与模板画面的相似度（0–1），达到阈值才算命中；命中的状态固定排在最前面；– 表示该状态没有模板，或这一帧画面缺少可比对的内容。" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 诊断抽屉：默认只占一行摘要 -->
                    <Border
                        Grid.Row="2"
                        Padding="0"
                        Style="{StaticResource Card}">
                        <StackPanel>
                            <Button
                                x:Name="DiagnosticsToggleButton"
                                Padding="14,12"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="ToggleDiagnostics_Click"
                                CornerRadius="{StaticResource RadiusCard}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        x:Name="DiagnosticsChevron"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextTertiaryBrush}"
                                        Glyph="&#xE70D;" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SectionHeader}" Text="诊断" />
                                    <TextBlock
                                        x:Name="DiagnosticsSummaryText"
                                        Grid.Column="2"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionText}"
                                        Text="正在检查资源…"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Button>

                            <Grid
                                x:Name="DiagnosticsPanel"
                                Height="300"
                                Padding="16,0,16,16"
                                ColumnSpacing="18"
                                Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.1*" />
                                </Grid.ColumnDefinitions>

                                <!-- 左：模板与语音 -->
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource BodyText}" Text="模板与语音" />
                                        <TextBlock
                                            x:Name="VoiceStatsText"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CaptionText}"
                                            Text="语音 —" />
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="8">
                                            <ItemsRepeater x:Name="ResourceStateRepeater">
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="local:ResourceStateItem">
                                                        <Grid Padding="0,4" ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                Foreground="{ThemeResource TextPrimaryBrush}"
                                                                Text="{x:Bind StateName}"
                                                                TextTrimming="CharacterEllipsis"
                                                                ToolTipService.ToolTip="{x:Bind Description}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                FontSize="12"
                                                                Foreground="{ThemeResource TextTertiaryBrush}"
                                                                Text="{x:Bind VoiceText}" />
                                                            <Border
                                                                Grid.Column="2"
                                                                Background="{ThemeResource SuccessSoftBrush}"
                                                                Style="{StaticResource StatusPill}"
                                                                Visibility="{x:Bind HasTemplate}">
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextSuccessBrush}"
                                                                    Style="{StaticResource PillText}"
                                                                    Text="已就绪" />
                                                            </Border>
                                                            <Border
                                                                Grid.Column="2"
                                                                Background="{ThemeResource MutedSoftBrush}"
                                                                Style="{StaticResource StatusPill}"
                                                                ToolTipService.ToolTip="该状态没有对应的模板文件，因此不会参与识别。"
                                                                Visibility="{x:Bind IsNoTemplate}">
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextMutedBrush}"
                                                                    Style="{StaticResource PillText}"
                                                                    Text="无模板" />
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>

                                            <Expander x:Name="UnmappedVoicesExpander" Header="未映射的语音文件">
                                                <TextBlock
                                                    x:Name="UnmappedVoicesText"
                                                    Margin="0,4,0,0"
                                                    FontFamily="{StaticResource MonoFontFamily}"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                                    TextWrapping="Wrap" />
                                            </Expander>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>

                                <!-- 右：运行日志 -->
                                <Grid Grid.Column="1" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource BodyText}" Text="运行日志" />
                                        <Button
                                            Grid.Column="1"
                                            Padding="10,4"
                                            Click="ClearLog_Click"
                                            Content="清空" />
                                        <Button
                                            Grid.Column="2"
                                            Margin="8,0,0,0"
                                            Padding="10,4"
                                            Click="OpenLogFolder_Click"
                                            Content="打开日志目录" />
                                    </Grid>
                                    <StackPanel Grid.Row="1">
                                        <TextBlock x:Name="DebugSourceText" Style="{StaticResource CaptionText}" Text="捕获源：未开始" TextWrapping="Wrap" />
                                        <TextBlock x:Name="DebugFrameInfoText" Style="{StaticResource CaptionText}" Text="当前帧：等待首帧" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ScrollViewer
                                        x:Name="DebugLogScroll"
                                        Grid.Row="2"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsRepeater x:Name="DebugLogRepeater">
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock
                                                        Margin="0,0,0,4"
                                                        FontFamily="{StaticResource MonoFontFamily}"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextSecondaryBrush}"
                                                        Text="{x:Bind}"
                                                        TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= 设置 ================= -->
                <ScrollViewer
                    x:Name="SettingsView"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <StackPanel
                        Width="720"
                        HorizontalAlignment="Left"
                        Spacing="12">
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource SectionHeader}" Text="识别" />
                                <TextBlock Style="{StaticResource BodyText}" Text="模板匹配阈值" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <Slider
                                        x:Name="SettingsThresholdSlider"
                                        Maximum="0.999"
                                        Minimum="0.5"
                                        StepFrequency="0.001"
                                        ValueChanged="SettingsThresholdSlider_ValueChanged" />
                                    <TextBlock
                                        x:Name="SettingsThresholdText"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Style="{StaticResource CaptionText}"
                                    Text="默认 0.90；修改后对下一次识别立即生效。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource SectionHeader}" Text="语音输出" />
                                <ComboBox
                                    x:Name="AudioDeviceList"
                                    DisplayMemberPath="Name"
                                    PlaceholderText="选择音频输出设备"
                                    SelectionChanged="AudioDeviceList_SelectionChanged" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <Slider
                                        x:Name="AudioVolumeSlider"
                                        Maximum="1"
                                        Minimum="0"
                                        StepFrequency="0.05"
                                        ValueChanged="AudioVolumeSlider_ValueChanged" />
                                    <TextBlock
                                        x:Name="AudioVolumeText"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Style="{StaticResource CaptionText}"
                                    Text="选择“跟随系统输出”时，语音会播放到系统当前的默认设备，并在默认设备切换后自动跟进。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource SectionHeader}" Text="运行行为" />
                                <CheckBox x:Name="StartWithWindowsCheck" Content="开机自动启动" />
                                <CheckBox x:Name="MinimizeToTrayCheck" Content="最小化到系统托盘" />
                                <CheckBox x:Name="CheckUpdatesCheck" Content="每天检查一次更新" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Click="SaveSettings_Click"
                                Content="保存设置"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button Click="OpenDataFolder_Click" Content="打开数据目录" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= 关于与日志 ================= -->
                <ScrollViewer
                    x:Name="AboutView"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <StackPanel
                        Width="720"
                        HorizontalAlignment="Left"
                        Spacing="12">
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Name="VersionText"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock
                                    Style="{StaticResource BodyText}"
                                    Text="基于原 OBS 插件的识别逻辑重做，不依赖 OBS、不注入游戏进程。界面使用 WinUI 3 / Windows App SDK。"
                                    TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="许可证：GPL-2.0-or-later" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <HyperlinkButton
                                        Content="GitHub 仓库"
                                        NavigateUri="https://github.com/qihe114514/Kanami-Reporter-Standalone" />
                                    <HyperlinkButton
                                        Content="官方网站"
                                        NavigateUri="https://app.qihe0507.top/Kanami" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource SectionHeader}" Text="反作弊与免责声明" />
                                <TextBlock
                                    Style="{StaticResource BodyText}"
                                    Text="本软件是非官方第三方工具，与《三角洲行动》的开发商、发行商及其关联公司没有任何关系，未获其授权、认可或赞助。它只读取屏幕画面并播放本地语音提示，不参与、不干预、不改变游戏本身的运行。使用任何第三方工具的风险由使用者自行承担，最终是否允许使用，以游戏官方的用户协议和反作弊策略为准。"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource BodyText}"
                                    Text="不注入游戏进程、不 Hook 任何函数、不读写游戏内存、不修改游戏文件或网络流量、不绕过任何反作弊机制；模板匹配、状态判断与语音播报全部在本机完成，不联网、不上传屏幕内容。"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource CaptionText}"
                                    Text="屏幕采集在某些反作弊策略下可能被误判为异常，本软件无法代表或保证游戏反作弊系统如何判定你的账号，不承诺“绝对不会被处罚”。请在正式账号上使用前确认游戏官方用户协议，一切后果由使用者自负。"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <HyperlinkButton
                                        Content="完整免责声明"
                                        NavigateUri="https://github.com/qihe114514/Kanami-Reporter-Standalone/blob/main/DISCLAIMER.md" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource SectionHeader}" Text="更新" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="CheckUpdate_Click" Content="检查更新" />
                                    <Button
                                        x:Name="DownloadUpdateButton"
                                        Click="DownloadUpdate_Click"
                                        Content="下载并安装更新"
                                        IsEnabled="False" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="UpdateStatusText"
                                    Style="{StaticResource BodyText}"
                                    Text="尚未检查更新。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource SectionHeader}" Text="日志" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="OpenLogFolder_Click" Content="打开日志目录" />
                                    <TextBlock
                                        x:Name="LogPathText"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionText}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
