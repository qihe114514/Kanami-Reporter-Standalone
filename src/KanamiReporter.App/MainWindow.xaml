<Window
    x:Class="KanamiReporter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="香奈美播报员">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏 -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="16,0,176,0"
            Background="#CC101821">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Width="20" Height="20" Source="ms-appx:///Assets/AppIcon.png" />
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="香奈美播报员" />
                <Border
                    Padding="8,2"
                    Background="#282F6DFF"
                    CornerRadius="10">
                    <TextBlock
                        x:Name="TitleStatusText"
                        FontSize="11"
                        Foreground="#FFB9D1FF"
                        Text="待机" />
                </Border>
            </StackPanel>

            <TextBlock
                x:Name="TitleSubtitleText"
                Grid.Column="1"
                Margin="18,0,0,0"
                VerticalAlignment="Center"
                Foreground="#B8FFFFFF"
                Text="识别已停止" />
        </Grid>

        <NavigationView
            x:Name="MainNav"
            Grid.Row="1"
            Background="Transparent"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            OpenPaneLength="180"
            PaneDisplayMode="LeftCompact">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="RunNavItem" Content="运行" Tag="run">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNavItem" Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AboutNavItem" Content="关于与日志" Tag="about">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Margin="20,16,20,20">
                <!-- 运行 -->
                <ScrollViewer
                    x:Name="RunView"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <InfoBar
                            x:Name="WelcomeBar"
                            IsClosable="True"
                            IsOpen="False"
                            Message="模板与语音已随程序内置，首次启动会自动准备，无需再导入资源包。"
                            Severity="Informational"
                            Title="内置资源包已就绪" />

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="捕获源" Style="{StaticResource SectionHeader}" />
                                    <ComboBox
                                        x:Name="CaptureTargets"
                                        DisplayMemberPath="DisplayName"
                                        PlaceholderText="选择游戏窗口或显示器"
                                        ToolTipService.ToolTip="列表每 2 秒自动刷新，也会保留当前选择" />
                                    <TextBlock
                                        x:Name="CaptureHintText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="正在准备捕获源…"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Content="立即刷新"
                                    Click="RefreshTargets_Click" />
                                <Button
                                    x:Name="StartRecognitionButton"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Content="开始识别"
                                    Click="StartRecognition_Click"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    x:Name="StopRecognitionButton"
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Content="停止"
                                    Click="StopRecognition_Click" />
                            </Grid>
                        </Border>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.45*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Padding="0" Style="{StaticResource Card}">
                                <Grid>
                                    <Viewbox Stretch="Uniform">
                                        <Grid Width="1280" Height="720" Background="#10151D">
                                            <Image
                                                x:Name="RunPreviewImage"
                                                Stretch="UniformToFill" />
                                            <Border
                                                x:Name="CaptureHintBorder"
                                                Margin="18"
                                                Padding="14,10"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                Background="#D9121A24"
                                                CornerRadius="6">
                                                <TextBlock
                                                    Foreground="White"
                                                    Text="选择捕获源后点击“开始识别”，预览和识别数据会持续刷新。"
                                                    TextWrapping="Wrap" />
                                            </Border>
                                            <Border
                                                x:Name="PreviewStatusBadge"
                                                Margin="14"
                                                Padding="9,5"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Background="#B3121A24"
                                                CornerRadius="6">
                                                <TextBlock
                                                    x:Name="PreviewStatusText"
                                                    Foreground="White"
                                                    Text="等待采集" />
                                            </Border>
                                            <Border
                                                Margin="14"
                                                Padding="9,5"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="#B3121A24"
                                                CornerRadius="6">
                                                <TextBlock
                                                    x:Name="FpsText"
                                                    Foreground="#FF9ED0FF"
                                                    Text="0.0 帧/秒" />
                                            </Border>
                                        </Grid>
                                    </Viewbox>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="12">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="对局观测" Style="{StaticResource SectionHeader}" />
                                            <TextBlock
                                                x:Name="GamePhaseText"
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="等待识别" />
                                        </Grid>

                                        <TextBlock
                                            x:Name="CurrentStateText"
                                            FontSize="26"
                                            FontWeight="SemiBold"
                                            Text="未知" />

                                        <Grid ColumnSpacing="10" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border Padding="10" Background="#10151D" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock FontSize="11" Foreground="#9EFFFFFF" Text="估算倒计时" />
                                                    <TextBlock
                                                        x:Name="GameCountdownText"
                                                        FontSize="20"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FF9ED0FF"
                                                        Text="--:--" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Padding="10" Background="#10151D" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock FontSize="11" Foreground="#9EFFFFFF" Text="回合 / 阵营" />
                                                    <TextBlock
                                                        x:Name="GameRoundText"
                                                        FontSize="16"
                                                        FontWeight="SemiBold"
                                                        Text="回合 --" />
                                                    <TextBlock
                                                        x:Name="GameSideText"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="阵营：未知" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="10" Background="#10151D" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock FontSize="11" Foreground="#9EFFFFFF" Text="阶段计时 / 下一判定" />
                                                    <TextBlock
                                                        x:Name="DebugStateDurationText"
                                                        Text="阶段计时：0.0 秒" />
                                                    <TextBlock
                                                        x:Name="GameEventText"
                                                        Foreground="#FFFFC46B"
                                                        Text="等待识别数据"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="10" Background="#10151D" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock FontSize="11" Foreground="#9EFFFFFF" Text="当前模板" />
                                                    <TextBlock
                                                        x:Name="ScoreText"
                                                        FontSize="17"
                                                        FontWeight="SemiBold"
                                                        Text="-" />
                                                    <TextBlock
                                                        x:Name="DebugThresholdText"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="匹配阈值：0.900" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <TextBlock
                                            x:Name="VoicePlaybackText"
                                            Foreground="#FF9ED0FF"
                                            Text="语音：空闲"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="模板匹配" Style="{StaticResource SectionHeader}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="仅按分数降序" />
                                        </Grid>
                                        <ListView
                                            x:Name="TemplateScoreList"
                                            Grid.Row="1"
                                            MaxHeight="470"
                                            SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="2,5" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="26" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="62" />
                                                            <ColumnDefinition Width="44" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding RankText}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Text="{Binding StateName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            FontFamily="Consolas"
                                                            Text="{Binding ScoreText}"
                                                            TextAlignment="Right" />
                                                        <TextBlock
                                                            Grid.Column="3"
                                                            FontSize="11"
                                                            Foreground="{Binding StatusBrush}"
                                                            Text="{Binding Status}"
                                                            TextAlignment="Right" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="资源状态" Style="{StaticResource SectionHeader}" />
                                            <TextBlock
                                                x:Name="ResourceCountText"
                                                Grid.Column="1"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="模板 0/15 · 语音 0/0" />
                                        </Grid>
                                        <TextBlock
                                            x:Name="ResourceSummaryText"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="正在检查资源映射…"
                                            TextWrapping="Wrap" />
                                        <Expander Header="查看资源映射详情">
                                            <TextBlock
                                                x:Name="ResourceDetailText"
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                TextWrapping="Wrap" />
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Card}">
                            <Expander Header="识别调试信息">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        x:Name="DebugSourceText"
                                        Text="捕获源：未开始"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="DebugFrameInfoText"
                                        Text="当前帧：等待首帧"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="DebugLogSummaryText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="日志仅保留最近 160 条；匹配列表按分数降序排列。" />
                                    <ListView
                                        x:Name="DebugLogList"
                                        Height="150"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        SelectionMode="None" />
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 设置 -->
                <ScrollViewer
                    x:Name="SettingsView"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="识别" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="模板匹配阈值" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <Slider
                                        x:Name="SettingsThresholdSlider"
                                        Maximum="0.999"
                                        Minimum="0.5"
                                        StepFrequency="0.001"
                                        ValueChanged="SettingsThresholdSlider_ValueChanged" />
                                    <TextBlock
                                        x:Name="SettingsThresholdText"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="默认 0.90；修改后对下一次识别立即生效。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="语音输出" Style="{StaticResource SectionHeader}" />
                                <ComboBox
                                    x:Name="AudioDeviceList"
                                    DisplayMemberPath="Name"
                                    PlaceholderText="选择音频输出设备"
                                    SelectionChanged="AudioDeviceList_SelectionChanged" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <Slider
                                        x:Name="AudioVolumeSlider"
                                        Maximum="1"
                                        Minimum="0"
                                        StepFrequency="0.05"
                                        ValueChanged="AudioVolumeSlider_ValueChanged" />
                                    <TextBlock
                                        x:Name="AudioVolumeText"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="运行行为" Style="{StaticResource SectionHeader}" />
                                <CheckBox x:Name="StartWithWindowsCheck" Content="开机自动启动" />
                                <CheckBox x:Name="MinimizeToTrayCheck" Content="最小化到系统托盘" />
                                <CheckBox x:Name="CheckUpdatesCheck" Content="每天检查一次更新" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="保存设置"
                                Click="SaveSettings_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="打开数据目录" Click="OpenDataFolder_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <!-- 关于与日志 -->
                <ScrollViewer
                    x:Name="AboutView"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Name="VersionText"
                                    FontSize="20"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    TextWrapping="Wrap"
                                    Text="基于原 OBS 插件的识别逻辑重做，不依赖 OBS、不注入游戏进程。界面使用 WinUI 3 / Windows App SDK。" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="许可证：GPL-2.0-or-later" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="更新" Style="{StaticResource SectionHeader}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="检查更新" Click="CheckUpdate_Click" />
                                    <Button
                                        x:Name="DownloadUpdateButton"
                                        Content="下载并安装更新"
                                        Click="DownloadUpdate_Click"
                                        IsEnabled="False" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="UpdateStatusText"
                                    TextWrapping="Wrap"
                                    Text="尚未检查更新。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="日志" Style="{StaticResource SectionHeader}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="打开日志目录" Click="OpenLogFolder_Click" />
                                    <TextBlock
                                        x:Name="LogPathText"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
