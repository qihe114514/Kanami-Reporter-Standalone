<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        界面材质与语义色的唯一来源。
        所有界面元素只允许引用这里的 token，不再就地写颜色值。
        Default = 深色主题（WinUI 约定），Light / HighContrast 覆盖同名 key。
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="SurfaceCardBrush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="StrokeCardBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="SurfaceTileBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="StrokeTileBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="SurfacePillBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="SurfaceIdleBrush" Color="#0AFFFFFF" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8FFFFFFF" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#7AFFFFFF" />

            <SolidColorBrush x:Key="TextBrandBrush" Color="#FF9FE0" />
            <SolidColorBrush x:Key="BrandSoftBrush" Color="#2EFF9FE0" />
            <SolidColorBrush x:Key="BrandStrokeBrush" Color="#59FF9FE0" />

            <SolidColorBrush x:Key="TextTimerBrush" Color="#FFC46B" />
            <SolidColorBrush x:Key="TimerSoftBrush" Color="#2EFFC46B" />

            <SolidColorBrush x:Key="TextSuccessBrush" Color="#6CD97E" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2E6CD97E" />

            <SolidColorBrush x:Key="TextDangerBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#2EFF99A4" />

            <SolidColorBrush x:Key="MutedSoftBrush" Color="#1FFFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SurfaceCardBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="StrokeCardBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="SurfaceTileBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="StrokeTileBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="SurfacePillBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="SurfaceIdleBrush" Color="#06000000" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E4000000" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9E000000" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#72000000" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#72000000" />

            <SolidColorBrush x:Key="TextBrandBrush" Color="#C0269E" />
            <SolidColorBrush x:Key="BrandSoftBrush" Color="#1AC0269E" />
            <SolidColorBrush x:Key="BrandStrokeBrush" Color="#3DC0269E" />

            <SolidColorBrush x:Key="TextTimerBrush" Color="#9A5B00" />
            <SolidColorBrush x:Key="TimerSoftBrush" Color="#1F9A5B00" />

            <SolidColorBrush x:Key="TextSuccessBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1F0F7B0F" />

            <SolidColorBrush x:Key="TextDangerBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#1FC42B1C" />

            <SolidColorBrush x:Key="MutedSoftBrush" Color="#0F000000" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="SurfaceCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StrokeCardBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SurfaceTileBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StrokeTileBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SurfacePillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceIdleBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="TextBrandBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BrandSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BrandStrokeBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="TextTimerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TimerSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="TextSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="TextDangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="MutedSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 预览舞台：视频画面必须有稳定底色，两套主题下都保持同一块深色。 -->
    <SolidColorBrush x:Key="StageSurfaceBrush" Color="#0B0E13" />
    <SolidColorBrush x:Key="OverlaySurfaceBrush" Color="#A8000000" />
    <SolidColorBrush x:Key="TextOnVideoBrush" Color="#FFFFFFFF" />

    <CornerRadius x:Key="RadiusCard">8</CornerRadius>
    <CornerRadius x:Key="RadiusTile">6</CornerRadius>
    <CornerRadius x:Key="RadiusStageTop">8,8,0,0</CornerRadius>
    <!-- 小标签用略有圆角的矩形，而不是整颗胶囊：在 20 像素高度上圆角超过一半时会显得臃肿。 -->
    <CornerRadius x:Key="RadiusPill">4</CornerRadius>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="TilePadding">12</Thickness>
    <FontFamily x:Key="MonoFontFamily">Consolas</FontFamily>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StrokeCardBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <Style x:Key="CardTight" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="Tile" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceTileBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StrokeTileBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusTile}" />
        <Setter Property="Padding" Value="{StaticResource TilePadding}" />
    </Style>

    <!-- 状态标签：贴边的描边让它在卡片和标题栏上都立得住，不会像一块悬空的色斑。 -->
    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfacePillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StrokeTileBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="OverlayBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OverlaySurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusTile}" />
        <Setter Property="Padding" Value="9,5" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
    </Style>

    <Style x:Key="PillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="MetricLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
    </Style>

    <Style x:Key="MetricValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="MonoMetricValue" TargetType="TextBlock" BasedOn="{StaticResource MetricValue}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>
</ResourceDictionary>
